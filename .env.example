# Credenciais SSW — multi-transportadora
# Cotação dispara em paralelo para cada id em SSW_CARRIERS com credenciais preenchidas.
# Envia Rápido: acrescente `envia` em SSW_CARRIERS e preencha SSW_ENVIA_*.
#
# Local: copie para .env e preencha.
# Vercel: Project Settings > Environment Variables (nunca commitar senhas).

SSW_CARRIERS=lopesul,envia
SSW_DEFAULT_CARRIER=lopesul

SSW_LOPESUL_DOMINIO=
SSW_LOPESUL_LOGIN=
SSW_LOPESUL_SENHA=
SSW_LOPESUL_NOME=Lopesul

# Opcional: integração técnica Jetlu (não exibida como marca)
# SSW_JETLU_DOMINIO=
# SSW_JETLU_LOGIN=
# SSW_JETLU_SENHA=
# SSW_JETLU_NOME=Jetlu

# SSW_ENVIA_DOMINIO=
# SSW_ENVIA_LOGIN=
# SSW_ENVIA_SENHA=
# SSW_ENVIA_NOME=Envia Rápido

# Opcional: espelho do default (legado)
SSW_DOMINIO=
SSW_LOGIN=
SSW_SENHA=

SSW_COTACAO_URL=https://ssw.inf.br/ws/sswCotacao/index.php
SSW_COTACAO_COLETA_URL=https://ssw.inf.br/ws/sswCotacaoColeta/index.php
SSW_AREAS_URL=https://ssw.inf.br/2/areas
SSW_CIDADES_ORIGEM=CASCAVEL / PR,MARINGA / PR,LONDRINA / PR
PORT=3001

# Supabase (Project Settings > API Keys)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Aplique a migration supabase/migrations/007_cobertura_cidades.sql
# no SQL Editor do Supabase para liberar o cadastro manual de cobertura.
# Aplique também 009_veiculos_parceiros.sql e 010_veiculos_marca.sql
# para o formulário Cadastrar veículo.
